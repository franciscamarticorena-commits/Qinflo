rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isMember(famId) {
      return isAuth() &&
        request.auth.uid in
          get(/databases/$(database)/documents/families/$(famId)).data.members;
    }

    // User profiles
    match /users/{uid} {
      // Readable by any authenticated user (required for invite code lookup)
      allow read: if isAuth();

      // Create: only own doc
      allow create: if isAuth() && isOwner(uid);

      // Update own doc, OR update another user's doc only to mark invite consumed
      // (autoConnect sets coparentId + inviteConsumed on the inviting user's doc)
      allow update: if isAuth() && (
        isOwner(uid) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['coparentId', 'inviteConsumed']) &&
          request.resource.data.inviteConsumed == true &&
          resource.data.inviteConsumed != true
        )
      );

      allow delete: if false;
    }

    // Family documents + all subcollections
    match /families/{famId} {
      // Read: members only
      allow read: if isMember(famId);

      // Create: the creator must include themselves in members[]
      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.members;

      // Update: existing member, OR user adding themselves during invite connect flow
      allow update: if isAuth() && (
        isMember(famId) ||
        (
          request.auth.uid in request.resource.data.members &&
          !(request.auth.uid in resource.data.members)
        )
      );

      allow delete: if false;

      // All subcollections (calendar, expenses, messages, children, agreements,
      // reminders, proposals, events): members only
      match /{subcol}/{docId} {
        allow read, write: if isMember(famId);
      }
    }
  }
}
